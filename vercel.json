{
  "crons": [
    {
      "path": "/api/newsletter?a=verificar",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/area?a=notion-cron",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "api/newsletter.js": {
      "maxDuration": 60
    },
    "api/area.js": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "(sejaunique|canivete-de-vendas)\\.vercel\\.app"
        }
      ],
      "destination": "https://sejaunique.com/:path",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/page/aluban/site",
      "destination": "https://aluban-site.vercel.app/"
    },
    {
      "source": "/page/aluban/site/:path*",
      "destination": "https://aluban-site.vercel.app/:path*"
    }
  ]
}
